# Copy this file to .env (in the project root) and fill in the values.
# .env is gitignored, so your keys never get committed.

# Groq API key for the Llama 3.1 model (get one at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_key_here

# Secret used to sign login tokens (JWT). Use a long random string, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string

# Password given to auto-created demo patient accounts
DEMO_PATIENT_PASSWORD=patient123
